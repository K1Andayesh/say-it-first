{
  "name": "@say-it-first/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform android",
    "preandroid": "pnpm --filter @say-it-first/contracts build && pnpm --filter @say-it-first/domain build",
    "lint": "eslint App.tsx src app.config.ts --max-warnings=0",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prestart": "pnpm --filter @say-it-first/contracts build && pnpm --filter @say-it-first/domain build",
    "start": "expo start --dev-client",
    "test": "vitest run src/services/realtime/realtime-events.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@say-it-first/contracts": "workspace:*",
    "@say-it-first/domain": "workspace:*",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-incall-manager": "4.2.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}

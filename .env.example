# Mobile-public values. Never place server secrets behind EXPO_PUBLIC_ variables.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4100
EXPO_PUBLIC_ANDROID_PACKAGE=app.sayitfirst.dev
EXPO_PUBLIC_SENTRY_DSN=

# API runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=4100
LOG_LEVEL=debug
LOG_PRETTY=true
CORS_ORIGINS=
REQUEST_BODY_LIMIT_BYTES=100000

# OpenAI - server only
OPENAI_API_KEY=
AI_REALTIME_MODEL=gpt-realtime-2.1
AI_EVALUATION_MODEL=gpt-5.6-terra
AI_REALTIME_VOICE=marin
AI_REQUEST_TIMEOUT_MS=30000
SAFETY_HASH_SALT=replace-with-a-long-random-secret

# Optional production telemetry
OTEL_SERVICE_NAME=say-it-first-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Phase 1 later checkpoints
DATABASE_URL=
JWT_SIGNING_KEY=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
ONESIGNAL_REST_API_KEY=
